{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "private-dns",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-24",
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
      "persist": true,
		}
	},
  "assets": {
    "directory": "public",
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "${ROUTE_DOMAIN}",
      "zone_name": "${ROUTE_ZONE}",
    },
  ],
	"d1_databases": [
		{
      "remote": false,
			"binding": "db",
			"database_name": "private-dns",
			"database_id": "${D1_DATABASE_ID}",
      "migrations_dir": "drizzle/migrations",
		},
	],
  "kv_namespaces": [
    {
      "remote": false,
      "binding": "kv",
      "id": "${KV_DATABASE_ID}",
    },
  ],
}
