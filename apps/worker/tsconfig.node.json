{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": true,
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "drizzle.config.ts",
    "cloudflare.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "pages.config.ts"
  ]
}
