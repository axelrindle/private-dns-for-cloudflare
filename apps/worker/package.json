{
  "private": true,
  "version": "1.0.0",
  "name": "@app/worker",
  "description": "Private DNS powered by Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy --secrets-file .dev.vars.production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings src/cloudflare.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio --verbose",
    "db:seed": "bun run drizzle/seed/index.ts",
    "test": "vitest run",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:inspect": "eslint-config-inspector"
  },
  "dependencies": {
    "@dnsquery/dns-packet": "^6.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@scalar/hono-api-reference": "^0.10.10",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.12.31",
    "hono-openapi": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@eslint/config-inspector": "^3.1.0",
    "@scalar/types": "^0.9.2",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.7.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.0"
  }
}
